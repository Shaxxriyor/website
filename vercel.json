{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/content.js": { "includeFiles": "content/**" }
  },
  "rewrites": [
    { "source": "/marathon/:path*", "destination": "/api/content?path=marathon/:path*" },
    { "source": "/practice/:path*", "destination": "/api/content?path=practice/:path*" },
    { "source": "/els/:path*", "destination": "/api/content?path=els/:path*" },
    { "source": "/vocab/:path*", "destination": "/api/content?path=vocab/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
