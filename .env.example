# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Optional: a long random string. Defaults to a key derived from ADMIN_PASSWORD.
SESSION_SECRET=
# Set automatically when you connect Neon Postgres in Vercel → Storage.
# Leave empty locally to use the built-in PGlite database in .data/.
DATABASE_URL=
